<?xml version="1.0" encoding="utf-8"?>
<!-- Hazır süre widget'ı: eklenirken hazır süre seçilir, sonradan değiştirilebilir -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.enesilhan.countdownalarm.widget.WidgetConfigActivity"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_preset"
    android:minWidth="180dp"
    android:minHeight="50dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/widget_preset_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
